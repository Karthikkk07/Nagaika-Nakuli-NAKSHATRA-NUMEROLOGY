# Copy to .env and fill in. Everything is optional: without it, enquiries are saved to data/enquiries.jsonl
# and notifications are printed to the server console.
PORT=3000

# Email (admin notification) - any SMTP provider
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nagaika, Nakuli Numerology <no-reply@numerologybangalore.in>"
ADMIN_EMAIL=anand@arninvest.in

# SMS (admin notification + OTP) - Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ADMIN_PHONE=+919845610894

# Admin dashboard at /admin. Change the password!
ADMIN_USER=admin
ADMIN_PASSWORD=
# Optional two-factor login: run `node scripts/totp-secret.js`, paste the secret here and add it to an authenticator app
ADMIN_TOTP_SECRET=

# Payments (without these, and outside production, payment runs in a labelled demo mode that moves no money)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard > Webhooks: URL https://YOUR-SITE/api/payments/razorpay/webhook, events payment.captured,
# order.paid, payment.failed, refund.processed, with this secret
RAZORPAY_WEBHOOK_SECRET=
PAYPAL_ME_LINK=https://www.paypal.me/your-paypal-handle
# Production hosts set NODE_ENV=production. Set DEMO_PAYMENTS=true there to keep the no-money demo payments (prototype link)
DEMO_PAYMENTS=

# WhatsApp Business Cloud API (Meta) for payment-failed and refund messages. Templates must be approved by Meta first.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_LANG=en
WHATSAPP_TEMPLATE_PAYMENT_FAILED=payment_failed
WHATSAPP_TEMPLATE_REFUND=refund_processed

# Public address of the site (used in sitemap.xml and robots.txt). Set it once you have a custom domain.
SITE_URL=
# Folder for numerology.db and daily backups (point at a persistent disk on the host)
DATA_DIR=
